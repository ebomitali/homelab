# Copia questo file in `stacks/<nome>/.env` e compila i valori.
# Non committare mai il file `.env` reale.

# Fuso orario usato dai container
TZ=Europe/Rome

# Dominio base per Traefik (i servizi sono su <nome>.${DOMAIN})
DOMAIN=home.zebco.it

# Esempio di segreto di uno stack (sostituisci o rimuovi)
# SERVICE_PASSWORD=changeme
