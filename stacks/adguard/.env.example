# Copia questo file in `stacks/adguard/.env` (uso locale) oppure imposta le
# stesse variabili nello stack Portainer. Non committare mai il file `.env` reale.

# Fuso orario usato dai container
TZ=Europe/Rome

# Dominio base: l'interfaccia è su adguard.<DOMAIN>
DOMAIN=home.zebco.it

# Cartella `data/` dell'host, path assoluto (es. /srv/homelab/data)
DATA_ROOT=/srv/homelab/data
