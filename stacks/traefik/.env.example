# Copia questo file in `stacks/traefik/.env`.
# Non committare mai il file `.env` reale.

# Fuso orario usato dai container
TZ=Europe/Rome

# Dominio base: la dashboard è su traefik.<DOMAIN>
DOMAIN=home.zebco.it

# Cartella `data/` dell'host, path assoluto (es. /srv/homelab/data).
# Contiene i certificati in traefik/certs e la configurazione TLS in traefik/dynamic.
DATA_ROOT=/srv/homelab/data
