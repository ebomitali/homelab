# Copia questo file in `stacks/n8n/.env` e compila i valori. Non committare mai il file `.env` reale.

# Versioni (vedi get-n8n.sh / n8n-io/n8n)
N8N_VERSION=
N8N_SANDBOX_VERSION=

# Dominio base: n8n è su n8n.<DOMAIN> tramite Traefik
DOMAIN=home.zebco.it
N8N_EDITOR_BASE_URL=https://n8n.home.zebco.it
WEBHOOK_URL=https://n8n.home.zebco.it/

# Runner e broker
N8N_RUNNERS_MODE=
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=
N8N_RUNNERS_AUTH_TOKEN=

# Sandbox (Instance AI)
N8N_INSTANCE_AI_SANDBOX_ENABLED=
N8N_INSTANCE_AI_SANDBOX_PROVIDER=
N8N_INSTANCE_AI_SANDBOX_API_URL=
N8N_SANDBOX_SERVICE_URL=
N8N_SANDBOX_SERVICE_API_KEY=
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SANDBOX_RUNNER_API_KEYS=

# SearXNG (assistente AI)
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=
INSTANCE_AI_BRAVE_SEARCH_API_KEY=
